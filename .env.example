# Copie para .env e preencha. O Foundry carrega o .env automaticamente.
# NUNCA faça commit do .env.

# RPC da Sepolia (Alchemy, Infura, QuickNode…). Ex.: https://eth-sepolia.g.alchemy.com/v2/<chave>
SEPOLIA_RPC_URL=

# Chave da API do Etherscan, para verificar o contrato (opcional).
ETHERSCAN_API_KEY=
