# Copie para .env.local e preencha (o Vite lê variáveis VITE_* no build).

# Rede: 11155111 = Sepolia (padrão), 17000 = Holesky, 84532 = Base Sepolia,
# 421614 = Arbitrum Sepolia, 11155420 = OP Sepolia, 31337 = Anvil local.
VITE_CHAIN_ID=11155111

# Endereço do Sorteio implantado. `npm run usar-deploy` preenche a partir do broadcast do Foundry.
VITE_SORTEIO_ADDRESS=

# Bloco do deploy: o histórico de vencedores busca eventos a partir dele.
VITE_DEPLOY_BLOCK=

# RPC para leitura (opcional; recomendado Alchemy/Infura, os públicos limitam eth_getLogs).
VITE_RPC_URL=
